{
  "buildCommand": "bash build.sh",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "HUGO_VERSION": "0.158.0"
  }
}
