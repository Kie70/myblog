{{- $.Scratch.Add "index" slice -}}
{{- range (partial "article_pages.html" .) -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) (ne .Type `page`) }}
    {{- $.Scratch.Add "index" (dict "title" .Title "permalink" .Permalink) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
